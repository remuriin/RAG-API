{
  "name": "rag-instance-api",
  "version": "0.1.0",
  "description": "RAG instance API: per-client markdown ingestion and question answering with pgvector and Gemini",
  "type": "module",
  "scripts": {
    "ingest": "tsx scripts/ingest.ts",
    "ask": "tsx scripts/ask.ts",
    "eval": "tsx scripts/eval.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:create-instance": "tsx scripts/dev-create-instance.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:management": "node dist/src/management/server.js",
    "start:agent": "node dist/src/agent/main.js",
    "dev:server": "tsx watch src/server.ts",
    "dev:management": "tsx watch src/management/server.ts",
    "dev:agent": "tsx src/agent/main.ts",
    "dev:firebase-token": "tsx scripts/dev-firebase-token.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^13.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
