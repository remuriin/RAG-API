# Route for one RAG instance. rag-ctl writes one of these per instance into /etc/nginx/rag-instances/
# from this template, installed root-owned at /etc/nginx/snippets/rag-instance.template.
# Only __INSTANCE_ID__ and __PORT__ are ever substituted.

location /i/__INSTANCE_ID__/ {
    limit_req zone=rag_api burst=10 nodelay;
    include /etc/nginx/snippets/rag-headers.conf;

    # the trailing slash strips /i/__INSTANCE_ID__, so the service sees /health, /documents, /query
    proxy_pass http://127.0.0.1:__PORT__/;

    # uploads wait for chunking and embedding before replying
    proxy_read_timeout 300s;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
