# Template unit: one service per RAG instance.
# Install as /etc/systemd/system/rag@.service, then start with: systemctl enable --now rag@<instanceId>
# %i is the part after the "@", i.e. the instance id.

[Unit]
Description=RAG instance %i
After=network-online.target postgresql.service
Wants=network-online.target
# A broken instance (bad env file, port in use) stops being retried after 5 starts in 10 minutes
# instead of restarting every 5 seconds forever. rag-ctl clears the counter when it starts one on purpose.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=rag
Group=rag
WorkingDirectory=/opt/rag
# Read by systemd as root before dropping to the rag user, so the file can stay root-only (chmod 600)
EnvironmentFile=/etc/rag/%i.env
Environment=NODE_ENV=production
# Adjust if `which node` prints a different path
ExecStart=/usr/bin/node dist/src/server.js
Restart=on-failure
RestartSec=5

# The service only reads its code and talks to Postgres and Gemini over the network
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
SystemCallArchitectures=native

# One instance embedding a 500 KB file must not take the whole VPS with it
MemoryMax=512M
TasksMax=256
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
