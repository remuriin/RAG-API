# Control agent: watches the instances table and sets services up / tears them down.
# No port, no endpoints. Install as /etc/systemd/system/rag-agent.service

[Unit]
Description=RAG control agent
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# Owns /etc/rag; reaches root only through sudo /usr/local/sbin/rag-ctl, which also writes the nginx routes.
# No NoNewPrivileges here: it would also apply to sudo and break rag-ctl. The settings below don't touch privileges.
User=ragagent
Group=ragagent
WorkingDirectory=/opt/rag
EnvironmentFile=/etc/rag-control/agent.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/src/agent/main.js
Restart=on-failure
RestartSec=5

ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
