# Copy to .env and fill in. On the VPS each instance gets its own /etc/rag/<instanceId>.env instead.
GEMINI_API_KEY=
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/rag_service

# Printed by: npm run dev:create-instance -- "<instance name>" ["<product name>"]
INSTANCE_ID=
PORT=4101

# --- Management API (src/management) ---
# Firebase project used for login. Only the project id is needed to verify ID tokens.
FIREBASE_PROJECT_ID=
# MGMT_PORT=4000
# PUBLIC_BASE_URL=https://rag.140-245-60-8.sslip.io
# CORS_ORIGIN=http://localhost:5173
# MAX_INSTANCES_PER_USER=3

# --- Control agent (src/agent) ---
# On a development machine, exercise the status handling without systemd or nginx
# AGENT_DRY_RUN=true

# --- Only for npm run dev:firebase-token ---
FIREBASE_WEB_API_KEY=
TEST_EMAIL=
TEST_PASSWORD=
